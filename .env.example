# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file — only this example.

# Which provider to use: gemini | openai | anthropic | groq | mock
PYSYNGUARD_PROVIDER=groq

# Only fill in the ONE key matching the provider above.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: override the default model for the chosen provider
# PYSYNGUARD_MODEL=openai/gpt-oss-120b
